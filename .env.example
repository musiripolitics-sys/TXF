# Copy to .env.local and fill in. .env.local is gitignored.
#
# Anything named NEXT_PUBLIC_* is compiled into the browser bundle and is
# public. Everything else is server-only. Note that Next.js bakes these in at
# BUILD time, so changing one on Netlify needs a redeploy, not a restart.

# ─────────────────────────── Supabase ───────────────────────────

# Project URL (Dashboard → Project Settings → Data API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Publishable / anon key — safe for the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Service-role / secret key — SERVER ONLY. Bypasses RLS. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────── Razorpay ───────────────────────────
#
# Three values, all server-only: the key id is handed to the browser by
# /api/payments/ticket-order at checkout time, so there is no NEXT_PUBLIC_
# copy of it and there should not be one.
#
# Dashboard → Account & Settings → API Keys → Generate. The secret is shown
# exactly once. Test keys start rzp_test_ and take only test cards; live keys
# start rzp_live_ and need a KYC-activated account.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# A string YOU choose when creating the webhook, pasted identically in both
# places. Dashboard → Settings → Webhooks → Add New Webhook:
#   URL    https://techxfluence.com/api/payments/webhook
#   Event  payment.captured
# It is what /api/payments/webhook checks the signature against, and it is the
# safety net that fulfils an order when the buyer's browser dies mid-payment.
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────── Email ───────────────────────────

# Either SMTP or Resend. SMTP wins if both are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# The From address on everything the site sends.
EMAIL_FROM=admin@techxfluence.com

# ─────────────────────────── Site ───────────────────────────

# Absolute origin, used in email links and in the sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://techxfluence.com

# Shared secret for /api/cron/reminders, sent as Authorization: Bearer.
CRON_SECRET=
